# Server
PORT=3000
HOST=127.0.0.1

# SQLite
SQLITE_PATH=./data/queue.db

# Endpunkt-Konfiguration
ENDPOINTS_YAML=./endpoints.yaml

# Logging
LOG_LEVEL=info

# Worker
WORKER_POLL_MS=3000
WORKER_BATCH=10
WORKER_MAX_ATTEMPTS=3

# SQL Server (für Worker)
# SQLSERVER_HOST=localhost
# SQLSERVER_DB=WebhookDB
# SQLSERVER_USER=sa
# SQLSERVER_PASS=

# SQL Server Pool
SQLSERVER_PORT=1433
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_CERT=false
SQLSERVER_WINDOWS_AUTH=false
SQLSERVER_POOL_MIN=2
SQLSERVER_POOL_MAX=10
SQLSERVER_POOL_IDLE=30000
SQLSERVER_REQUEST_TIMEOUT=30000

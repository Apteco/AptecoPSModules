<?xml version="1.0" encoding="UTF-8"?>
<!--
  web.config für IIS ARR (Application Request Routing)
  Leitet /webhook und /health an den lokalen Node.js-Prozess weiter.

  Voraussetzungen:
    - IIS ARR Modul installiert
    - URL Rewrite Modul installiert
    - ARR Proxy in IIS Manager aktiviert (Server → Application Request Routing Cache → Proxy Settings → Enable proxy)
-->
<configuration>
  <system.webServer>

    <!--
      Explizites Request-Body-Limit erhöhen (Default ~28,6 MB sollte reichen,
      aber wir setzen es explizit auf 50 MB für Puffer bei großen Brevo-Batches).
    -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
        <!-- 52428800 Bytes = 50 MB -->
      </requestFiltering>
    </security>

    <rewrite>
      <rules>

        <!-- Alle Anfragen an Node.js weiterleiten -->
        <rule name="Proxy to Node.js Webhook Receiver" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <!-- Nur /webhook und /health durchleiten — alles andere blockieren -->
            <add input="{REQUEST_URI}" pattern="^/(webhook|health|admin/queue-stats)" />
          </conditions>
          <action
            type="Rewrite"
            url="http://127.0.0.1:3000/{R:0}"
          />
        </rule>

      </rules>

      <!-- Original-IP an Node.js weitergeben -->
      <outboundRules>
        <rule name="Add X-Forwarded-For">
          <match serverVariable="RESPONSE_X_Forwarded_For" pattern=".*" />
          <action type="Rewrite" value="{REMOTE_ADDR}" />
        </rule>
      </outboundRules>
    </rewrite>

    <!--
      ARR-spezifische Server-Variablen für Proxy-Header.
      Erlaubt das Setzen von HTTP_X_FORWARDED_FOR durch die Rewrite-Engine.
    -->
    <rewrite>
      <allowedServerVariables>
        <add name="HTTP_X_FORWARDED_FOR" />
      </allowedServerVariables>
    </rewrite>

  </system.webServer>
</configuration>
